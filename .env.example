# Base de datos (opcional)
# Si no se configura, la aplicación funcionará con datos mock
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_base_datos

# Ejemplo con Neon Database:
# DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Analytics (opcional)
# Para habilitar Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Modo de desarrollo
NODE_ENV=development
